{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["node"],
    "target": "es2019",
    "outDir": "out",
    "experimentalDecorators": true,
    "lib": ["es6", "es2017", "es2019"],
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true
  },
  "exclude": ["src/react", "node_modules", ".vscode-test"]
}
